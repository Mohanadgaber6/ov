# Frontend development/build
PORT=5173
BASE_PATH=/

# API server (use a different port when running both services locally)
# PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL / Drizzle (required for database schema commands and future persistence)
DATABASE_URL=

# SMTP Email Delivery (Deliveries sent securely to ovoffiice@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ovoffiice@gmail.com
SMTP_PASS=your-app-password-here
FROM_EMAIL="أوفي الذكية <ovoffiice@gmail.com>"
