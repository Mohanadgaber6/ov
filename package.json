{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/ov-office-site --filter @workspace/api-server run dev",
    "dev:site": "pnpm --filter @workspace/ov-office-site run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^10.0.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
